{
  "name": "drones-system-section",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "node scripts/validate-feature-registry.mjs && tsc --noEmit",
    "start": "tsx server.ts",
    "test": "node --test tests/*.test.mjs",
    "test:core": "node --test tests/database.test.mjs tests/record-sync.test.mjs",
    "backup": "node server/backup.mjs",
    "maps:setup": "node scripts/maps/setup.mjs",
    "maps:start": "node scripts/maps/start.mjs",
    "maps:stop": "docker stop drone-qatar-map",
    "maps:upgrade": "node scripts/maps/setup.mjs --upgrade",
    "admin:recover": "node server/recover-admin.mjs",
    "admin:reset:dev": "node server/recover-admin-dev.mjs",
    "check:permissions": "node scripts/validate-feature-registry.mjs",
    "prebuild": "npm run check:permissions"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "hls.js": "^1.5.18",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "maplibre-gl": "^6.14.0",
    "motion": "^12.23.24",
    "pmtiles": "^4.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/jsbarcode": "^3.11.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.16.0"
  }
}
